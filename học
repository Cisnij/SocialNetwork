7. Mixins
    VIEWSET THÌ TÍCH HỢP HẾT CRUD, GENERICS THÌ TỰ TỐI ƯU ĐƯỢC, MIXINS VỪA TỰ TỐI ƯU VỪA TÍCH HỢP HẾT THEO Ý 
    dùng để tái sử dụng code và kết hợp nhiều chức năng CRUD trong một class duy nhất ví dụ get post put delete
    thay vì 1 đối tượng phải tạo CreateAPIView và ListAPIView thì chỉ cần viết 1 class , có thể dùng để set permission theo dạng tối ưu code mà k cần viết lại từng dòng 
    #ví dụ: 
    CreateModelMixin	post()	Tạo mới object
    ListModelMixin	    get()	Lấy danh sách object
    RetrieveModelMixin	get()	Lấy 1 object theo pk
    UpdateModelMixin	put(), patch()	Cập nhật object
    DestroyModelMixin	delete()	Xóa object

    class MyModelView(CreateModelMixin, ListModelMixin, GenericAPIView):
    queryset = MyModel.objects.all()
    serializer_class = MyModelSerializer

    def get(self, request, *args, **kwargs):
        return self.list(request, *args, **kwargs)  # từ ListModelMixin

    def post(self, request, *args, **kwargs): # nhận tín hiệu post từ fe và xử lý
        return self.create(request, *args, **kwargs)  # từ CreateModelMixin
        #lookup_view ='pk' # nếu muốn lấy theo pk thì thêm dòng này, nhưng phải bỏ <int:pk> trong urls.py, bởi vì 2 cái này là trùng nhau

    def put(self, request, *args, **kwargs):
        return self.update(request, *args, **kwargs)  # từ UpdateModelMixin

    def delete(self, request, *args, **kwargs):
        return self.destroy(request, *args, **kwargs)  # từ DestroyModelMixin     

    def perform_create(self, serializer):
        serializer.save(user=self.request.user) # gán user vào khi tạo đối tượng để biết ai tạo 

