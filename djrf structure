## 4. `permissions.py` — tách permission logic phức tạp

# friendship/permissions.py

class IsRequestSender(BasePermission):
    message = "Not allowed"

    def has_object_permission(self, request, view, obj):
        return obj.from_user == request.user


## 5. `views.py` — giờ rất mỏng, chỉ orchestration

# friendship/views.py

class CancelFriendRequestView(generics.DestroyAPIView):
    permission_classes = [IsAuthenticated, IsRequestSender]
    throttle_classes = [ScopedRateThrottle]
    throttle_scope = 'cancel_friend_request'

    def destroy(self, request, *args, **kwargs):
        fr_id = self.kwargs.get('pk')
        if not fr_id:
            return Response({"detail": "ID is required"}, status=400)

        fr_obj = get_friend_request_or_404(fr_id=fr_id)
        self.check_object_permissions(request, fr_obj)  # kích hoạt IsRequestSender permission check quyền

        cancel_friend_request(fr_obj=fr_obj, user=request.user)
        return Response({"detail": "Friend request canceled"}, status=status.HTTP_200_OK)
